from pathlib import Path
import subprocess
import time

import cv2
import ncnn
import numpy as np

try:
    from picamera2 import Picamera2
except ImportError:
    Picamera2 = None


# =========================
# CAMINHOS NA RASPBERRY
# =========================
BASE_DIR = Path(__file__).resolve().parent
PROJETO_DIR = BASE_DIR.parent

CAMINHO_MODELO_NCNN = BASE_DIR / "weights" / "best_ncnn_model"
CAMINHO_PARAM = CAMINHO_MODELO_NCNN / "model.ncnn.param"
CAMINHO_BIN = CAMINHO_MODELO_NCNN / "model.ncnn.bin"

CAMINHO_FADIGA = PROJETO_DIR / "fadiga.mp3"
CAMINHO_MICROSLEEP = PROJETO_DIR / "alerta.mp3"


# =========================
# CONFIGURACOES
# =========================
LARGURA_CAMERA = 640
ALTURA_CAMERA = 480
IMG_SIZE = 224
CONFIANCA_MINIMA = 0.55
PROCESSAR_CADA_N_FRAMES = 2
USAR_ROI_CENTRAL_SEM_ROSTO = False

LIMITE_PISCADA = 0.4
LIMITE_ATENCAO = 1.0
LIMITE_FADIGA = 3.0
TEMPO_ACORDA_APOS_ABRIR = 10.0

CLASSES = {
    0: "olhos_abertos",
    1: "olhos_fechados",
}


# =========================
# ESTADO GLOBAL DO ALARME
# =========================
tempo_inicio_fechado = None
manter_acorda_ate = None
ja_entrou_microsleep = False

proc_fadiga = None
proc_acorda = None

ultimo_rosto = None
alpha = 0.65


class Camera:
    def __init__(self):
        self.picam2 = None
        self.cap = None
        self.usando_picamera2 = False

    def abrir(self):
        if Picamera2 is not None:
            try:
                self.picam2 = Picamera2()
                config = self.picam2.create_preview_configuration(
                    main={"size": (LARGURA_CAMERA, ALTURA_CAMERA), "format": "RGB888"}
                )
                self.picam2.configure(config)
                self.picam2.start()
                time.sleep(2)
                self.usando_picamera2 = True
                print("Camera iniciada com Picamera2.")
                return
            except Exception as exc:
                print(f"Falha ao abrir Picamera2, tentando OpenCV: {exc}")
                self.picam2 = None

        self.cap = cv2.VideoCapture(0)
        if not self.cap.isOpened():
            raise RuntimeError("Erro ao abrir a camera.")

        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, LARGURA_CAMERA)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, ALTURA_CAMERA)
        print("Camera iniciada com OpenCV VideoCapture.")

    def ler(self):
        if self.usando_picamera2:
            frame_rgb = self.picam2.capture_array()
            if frame_rgb is None:
                return False, None
            frame_bgr = cv2.cvtColor(frame_rgb, cv2.COLOR_RGB2BGR)
            return True, frame_bgr

        ret, frame = self.cap.read()
        return ret, frame

    def fechar(self):
        if self.picam2 is not None:
            self.picam2.stop()
        if self.cap is not None:
            self.cap.release()


def carregar_modelo_ncnn():
    if not CAMINHO_PARAM.exists() or not CAMINHO_BIN.exists():
        raise FileNotFoundError(
            "Modelo NCNN nao encontrado. Esperado em: "
            f"{CAMINHO_MODELO_NCNN}"
        )

    net = ncnn.Net()
    net.opt.num_threads = 2
    net.opt.use_vulkan_compute = False
    net.load_param(str(CAMINHO_PARAM))
    net.load_model(str(CAMINHO_BIN))
    return net


def configurar_audio_p2():
    """Tenta direcionar o audio para a saida P2 da Raspberry.

    Em algumas versoes do Raspberry Pi OS estes comandos podem nao existir.
    Nesse caso, o sistema usa a saida padrao configurada no desktop.
    """
    comandos = [
        ["amixer", "cset", "numid=3", "1"],
        ["amixer", "sset", "Master", "90%"],
    ]

    for comando in comandos:
        try:
            subprocess.run(
                comando,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except FileNotFoundError:
            pass


def tocar_audio(caminho):
    if not caminho.exists():
        print(f"Arquivo de audio nao encontrado: {caminho}")
        return None

    try:
        return subprocess.Popen(
            [
                "cvlc",
                "--intf",
                "dummy",
                "--no-video",
                "--loop",
                str(caminho),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print("cvlc nao encontrado. Instale com: sudo apt install -y vlc")
        return None


def parar_proc(proc):
    if proc is not None:
        proc.terminate()
        try:
            proc.wait(timeout=1.0)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
    return None


def tocar_fadiga():
    global proc_fadiga

    if proc_fadiga is None:
        proc_fadiga = tocar_audio(CAMINHO_FADIGA)


def parar_fadiga():
    global proc_fadiga

    proc_fadiga = parar_proc(proc_fadiga)


def tocar_acorda():
    global proc_acorda

    if proc_acorda is None:
        proc_acorda = tocar_audio(CAMINHO_MICROSLEEP)


def parar_acorda():
    global proc_acorda

    proc_acorda = parar_proc(proc_acorda)


def suavizar_box(box_atual, box_anterior, alpha=0.65):
    if box_anterior is None:
        return box_atual

    x, y, w, h = box_atual
    xa, ya, wa, ha = box_anterior

    x_s = int(alpha * xa + (1 - alpha) * x)
    y_s = int(alpha * ya + (1 - alpha) * y)
    w_s = int(alpha * wa + (1 - alpha) * w)
    h_s = int(alpha * ha + (1 - alpha) * h)

    return x_s, y_s, w_s, h_s


def softmax(valores):
    valores = valores.astype(np.float32)
    valores = valores - np.max(valores)
    exp = np.exp(valores)
    soma = np.sum(exp)
    if soma <= 0:
        return valores
    return exp / soma


def classificar_olho(recorte, net):
    if recorte is None or recorte.size == 0:
        return None, 0.0

    imagem = cv2.resize(recorte, (IMG_SIZE, IMG_SIZE), interpolation=cv2.INTER_LINEAR)
    imagem = cv2.cvtColor(imagem, cv2.COLOR_BGR2RGB)
    imagem = imagem.astype(np.float32) / 255.0
    imagem = np.transpose(imagem, (2, 0, 1))
    imagem = np.ascontiguousarray(imagem)

    with net.create_extractor() as ex:
        ex.input("in0", ncnn.Mat(imagem).clone())
        ret, saida = ex.extract("out0")

    if ret != 0:
        return None, 0.0

    probs = np.array(saida).reshape(-1)
    if probs.size < 2:
        return None, 0.0

    # Algumas exportacoes ja retornam probabilidades; se vierem logits,
    # normalizamos com softmax.
    if np.any(probs < 0) or not np.isclose(float(np.sum(probs)), 1.0, atol=0.05):
        probs = softmax(probs)

    classe_id = int(np.argmax(probs))
    conf = float(probs[classe_id])
    if conf < CONFIANCA_MINIMA:
        return None, conf

    return CLASSES.get(classe_id), conf


def combinar_resultados(classe_esq, conf_esq, classe_dir, conf_dir):
    if classe_esq is None and classe_dir is None:
        return "sem deteccao", 0.0
    if classe_esq is not None and classe_dir is None:
        return classe_esq, conf_esq
    if classe_esq is None and classe_dir is not None:
        return classe_dir, conf_dir
    if classe_esq == classe_dir:
        return classe_esq, max(conf_esq, conf_dir)
    if conf_esq >= conf_dir:
        return classe_esq, conf_esq
    return classe_dir, conf_dir


def detectar_rosto(gray, face_cascade):
    gray_eq = cv2.equalizeHist(gray)
    faces = face_cascade.detectMultiScale(
        gray_eq,
        scaleFactor=1.05,
        minNeighbors=4,
        minSize=(80, 80),
    )

    if len(faces) == 0:
        return None

    return max(faces, key=lambda f: f[2] * f[3])


def roi_olhos_por_rosto(frame_shape, face_box):
    x, y, w, h = face_box
    roi_y1 = max(0, y + int(h * 0.15))
    roi_y2 = min(frame_shape[0], y + int(h * 0.55))
    roi_x1 = max(0, x + int(w * 0.08))
    roi_x2 = min(frame_shape[1], x + int(w * 0.92))
    return roi_x1, roi_y1, roi_x2, roi_y2


def roi_olhos_central(frame_shape):
    altura, largura = frame_shape[:2]
    roi_x1 = int(largura * 0.20)
    roi_x2 = int(largura * 0.80)
    roi_y1 = int(altura * 0.20)
    roi_y2 = int(altura * 0.48)
    return roi_x1, roi_y1, roi_x2, roi_y2


def classificar_roi_olhos(frame, roi_box, net):
    roi_x1, roi_y1, roi_x2, roi_y2 = roi_box
    olhos_roi = frame[roi_y1:roi_y2, roi_x1:roi_x2]
    if olhos_roi.size == 0:
        return "sem deteccao", 0.0

    metade = olhos_roi.shape[1] // 2
    olho_esq = olhos_roi[:, :metade]
    olho_dir = olhos_roi[:, metade:]

    classe_esq, conf_esq = classificar_olho(olho_esq, net)
    classe_dir, conf_dir = classificar_olho(olho_dir, net)
    return combinar_resultados(classe_esq, conf_esq, classe_dir, conf_dir)


def cor_por_resultado(resultado):
    if resultado == "olhos_abertos":
        return (255, 0, 0)
    if resultado == "olhos_fechados":
        return (0, 255, 255)
    return (0, 0, 255)


def atualizar_alerta(resultado_final, frame_vis):
    global tempo_inicio_fechado
    global manter_acorda_ate
    global ja_entrou_microsleep

    agora = time.time()
    mensagem_tela = ""

    if manter_acorda_ate is not None:
        tempo_restante = manter_acorda_ate - agora

        if tempo_restante > 0:
            parar_fadiga()
            cv2.putText(
                frame_vis,
                f"Alarme critico: {max(0, tempo_restante):.1f}s",
                (20, 65),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0, 0, 255),
                2,
            )
            return "ACORDA"

        parar_acorda()
        manter_acorda_ate = None
        tempo_inicio_fechado = None
        ja_entrou_microsleep = False

    if resultado_final == "sem deteccao":
        tempo_inicio_fechado = None
        ja_entrou_microsleep = False
        parar_fadiga()
        return ""

    if resultado_final == "olhos_fechados":
        if tempo_inicio_fechado is None:
            tempo_inicio_fechado = agora
            ja_entrou_microsleep = False

        tempo_fechado = agora - tempo_inicio_fechado

        cv2.putText(
            frame_vis,
            f"Olhos fechados: {tempo_fechado:.1f}s",
            (20, 65),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0, 0, 255),
            2,
        )

        if tempo_fechado < LIMITE_PISCADA:
            mensagem_tela = ""

        elif LIMITE_ATENCAO <= tempo_fechado < LIMITE_FADIGA:
            mensagem_tela = "ATENCAO"
            parar_fadiga()

        elif tempo_fechado >= LIMITE_FADIGA:
            mensagem_tela = "ACORDA"
            parar_fadiga()

            if not ja_entrou_microsleep:
                tocar_acorda()
                manter_acorda_ate = agora + TEMPO_ACORDA_APOS_ABRIR
                ja_entrou_microsleep = True
                tempo_inicio_fechado = None

    else:
        tempo_inicio_fechado = None
        ja_entrou_microsleep = False
        parar_fadiga()

    return mensagem_tela


def desenhar_mensagem(frame_vis, mensagem_tela):
    if not mensagem_tela:
        return

    if mensagem_tela == "ATENCAO":
        cor_msg = (0, 255, 255)
    elif mensagem_tela == "FADIGA DETECTADA":
        cor_msg = (0, 165, 255)
    else:
        cor_msg = (0, 0, 255)

    cv2.putText(
        frame_vis,
        mensagem_tela,
        (30, 120),
        cv2.FONT_HERSHEY_SIMPLEX,
        1.5,
        cor_msg,
        4,
    )


def main():
    global ultimo_rosto

    configurar_audio_p2()
    net = carregar_modelo_ncnn()

    face_cascade = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )
    if face_cascade.empty():
        raise RuntimeError("Erro ao carregar o Haar Cascade.")

    camera = Camera()
    camera.abrir()

    frame_count = 0
    ultimo_resultado = {
        "face_box": None,
        "eye_box": None,
        "texto": "sem deteccao",
        "cor": (0, 0, 255),
        "resultado": "sem deteccao",
    }

    print("Sistema iniciado. Pressione 'q' para sair.")

    try:
        while True:
            ret, frame = camera.ler()
            if not ret or frame is None:
                print("Erro ao capturar frame.")
                break

            frame_vis = frame.copy()
            frame_count += 1

            if frame_count % PROCESSAR_CADA_N_FRAMES == 0:
                gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
                face_box = detectar_rosto(gray, face_cascade)

                origem = "rosto"
                if face_box is not None:
                    face_box = suavizar_box(face_box, ultimo_rosto, alpha)
                    ultimo_rosto = face_box
                    roi_box = roi_olhos_por_rosto(frame.shape, face_box)
                elif USAR_ROI_CENTRAL_SEM_ROSTO:
                    ultimo_rosto = None
                    origem = "roi central"
                    roi_box = roi_olhos_central(frame.shape)
                else:
                    ultimo_rosto = None
                    roi_box = None

                if roi_box is not None:
                    resultado_final, confianca_final = classificar_roi_olhos(
                        frame,
                        roi_box,
                        net,
                    )
                    cor = cor_por_resultado(resultado_final)
                    texto = (
                        f"{resultado_final} {confianca_final:.2f} ({origem})"
                        if resultado_final != "sem deteccao"
                        else f"sem deteccao ({origem})"
                    )
                    ultimo_resultado = {
                        "face_box": face_box,
                        "eye_box": roi_box,
                        "texto": texto,
                        "cor": cor,
                        "resultado": resultado_final,
                    }
                else:
                    ultimo_resultado = {
                        "face_box": None,
                        "eye_box": None,
                        "texto": "Rosto nao detectado",
                        "cor": (0, 0, 255),
                        "resultado": "sem deteccao",
                    }

            if ultimo_resultado["face_box"] is not None:
                x, y, w, h = ultimo_resultado["face_box"]
                cv2.rectangle(frame_vis, (x, y), (x + w, y + h), (0, 255, 0), 2)

            if ultimo_resultado["eye_box"] is not None:
                roi_x1, roi_y1, roi_x2, roi_y2 = ultimo_resultado["eye_box"]
                cv2.rectangle(
                    frame_vis,
                    (roi_x1, roi_y1),
                    (roi_x2, roi_y2),
                    ultimo_resultado["cor"],
                    2,
                )
                cv2.putText(
                    frame_vis,
                    ultimo_resultado["texto"],
                    (roi_x1, max(roi_y1 - 10, 20)),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    ultimo_resultado["cor"],
                    2,
                )
            else:
                cv2.putText(
                    frame_vis,
                    ultimo_resultado["texto"],
                    (20, 30),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.8,
                    ultimo_resultado["cor"],
                    2,
                )

            mensagem_tela = atualizar_alerta(
                ultimo_resultado["resultado"],
                frame_vis,
            )
            desenhar_mensagem(frame_vis, mensagem_tela)

            cv2.imshow("Classificacao de olhos - Raspberry + NCNN + P2", frame_vis)

            if cv2.waitKey(1) & 0xFF == ord("q"):
                break

    finally:
        parar_fadiga()
        parar_acorda()
        camera.fechar()
        cv2.destroyAllWindows()
        print("Desligando...")


if __name__ == "__main__":
    main()
